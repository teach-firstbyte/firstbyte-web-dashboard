# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Monorepo note: patterns here are deliberately NOT anchored with a leading
# slash, so they apply inside every app under apps/ as well as at the root.
# An anchored pattern like "/node_modules" would miss apps/web/node_modules.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template of required variable names carries no secrets and should
# be committed, so new contributors know what to fill in.
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/settings.local.json

# prisma generated client
src/generated/prisma
