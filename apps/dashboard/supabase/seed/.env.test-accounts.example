# Copy to .env.test-accounts (git-ignored) and set one password per test
# login. The seed script gives the four @firstbyte.test accounts these
# passwords every time it runs.
#
# Make each one with:  openssl rand -base64 18
# The same file content is the PREVIEW_TEST_ACCOUNTS GitHub secret, so the
# "Reset preview database" workflow uses the same passwords. See "Preview
# environment" in apps/dashboard/README.md.

TEST_ADMIN_PASSWORD=
TEST_OFFICER_PASSWORD=
TEST_MEMBER_PASSWORD=
TEST_PENDING_PASSWORD=
