# Copy to .env.production and fill in the production database's connection
# strings. Used only by `npm run db:status:production` and
# `npm run db:migrate:production`, never by `npm run dev`. Never commit the
# filled file -- the root .gitignore covers it.
#
# Prefer the "Database migrations" GitHub Action, which keeps these values as
# secrets on GitHub instead of on your laptop. Use this file only when you must
# run a command against this database yourself.
#
# Values: Supabase dashboard for the production project -> Connect.
# Never point `prisma migrate dev` or `prisma db push` at this database:
# both can wipe its data.

# "Transaction pooler" string (port 6543 on *.pooler.supabase.com). Prisma
# needs it set, but migrations use DIRECT_URL below.
DATABASE_URL=

# "Session pooler" string (port 5432 on *.pooler.supabase.com). Migrations run
# through this one. Addresses on db.<project>.supabase.co (the direct
# connection, or the dedicated pooler) also work, but only on a network with
# IPv6.
DIRECT_URL=
