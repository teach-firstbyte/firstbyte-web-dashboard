# Copy to .env.preview and fill in the preview database's connection strings.
# Used only by `npm run db:status:preview` and `npm run db:migrate:preview`,
# never by `npm run dev`. Never commit the filled file -- the root .gitignore
# covers it.
#
# The preview database is the Supabase project kszxdakaiyispmrgicim (org
# "Software Website Team"). Vercel preview deployments use it; production uses
# a different project.
#
# Values: Supabase dashboard for the preview project -> Connect.
# Never point `prisma migrate dev` or `prisma db push` at this database:
# both can wipe its data.

# "Transaction pooler" string (port 6543 on *.pooler.supabase.com). Prisma
# needs it set, but migrations use DIRECT_URL below.
DATABASE_URL=

# "Session pooler" string (port 5432 on *.pooler.supabase.com). Migrations run
# through this one. Addresses on db.<project>.supabase.co (the direct
# connection, or the dedicated pooler) also work, but only on a network with
# IPv6.
DIRECT_URL=

# --- Seeding (npm run db:seed:preview / db:reset:preview only) ------------
# The seed script makes the four test logins through Supabase's admin API, so
# it needs the preview project's URL and secret key.
#   Supabase dashboard for the preview project -> Project Settings -> API Keys
#   -> Secret keys. Never use the production project's key here.
SUPABASE_URL=https://kszxdakaiyispmrgicim.supabase.co
SUPABASE_SECRET_KEY=
