# Copy to .env.local (or .env) and fill in real values. Never commit the filled
# files — the root .gitignore covers .env*.
#
# Values live in the Supabase dashboard (Project Settings -> API / Database) and
# in the Vercel project settings for the deployed environments.

# --- Database (Prisma) ----------------------------------------------------
# Pooled connection, used at runtime. Supabase gives this with pgbouncer=true
# and a connection_limit query param.
DATABASE_URL=

# Direct (non-pooled) connection on port 5432, used only by `prisma migrate`.
# Referenced by prisma/schema.prisma as directUrl. Migrations fail without it;
# normal runtime queries do not use it, which is why its absence went unnoticed.
DIRECT_URL=

# --- Supabase auth --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Public origin --------------------------------------------------------
# The origin users actually browse, used for URLs that leave the app (password
# reset emails). This app runs behind the marketing site's rewrite, so its own
# request host is the INTERNAL zone URL — a reset link built from that would
# point at the .vercel.app deployment instead of teachfirstbyte.com.
#   local dev:  http://localhost:3000   (the WEB app's port, not 3001)
#   production: https://teachfirstbyte.com
NEXT_PUBLIC_APP_URL=

# --- Attendance check-in --------------------------------------------------
# Server-only secret. HMAC key behind the 6-character meeting check-in codes
# (see src/lib/attendance/check-in-code.ts). Anyone with this value can forge a
# check-in, so keep it out of NEXT_PUBLIC_* and rotate it if it leaks.
CHECKIN_SECRET=

# --- Supabase admin (server-only) -----------------------------------------
# The project's secret key. Used only to remove someone's login when their
# account is deleted (see src/lib/supabase/admin.ts). It skips every Supabase
# access rule, so NEVER give it a NEXT_PUBLIC_ prefix and never commit it.
#   local dev:  the "Secret" key (sb_secret_...) printed by `supabase status`
#   production: Supabase dashboard -> Project Settings -> API Keys -> Secret
#               keys, then add it in the Vercel project settings
# Prefer a secret key (sb_secret_...) over the legacy service_role JWT, which
# Supabase is retiring by the end of 2026.
# Without it, deleting an account fails before it changes anything.
SUPABASE_SECRET_KEY=
