{
  "name": "firstbyte-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @firstbyte/web",
    "dev:dashboard": "npm run dev -w @firstbyte/dashboard -- --port 3001",
    "build": "npm run build -w @firstbyte/web && npm run build -w @firstbyte/dashboard",
    "build:web": "npm run build -w @firstbyte/web",
    "build:dashboard": "npm run build -w @firstbyte/dashboard",
    "verify:no-prisma-client:dashboard": "npm run verify:no-prisma-client -w @firstbyte/dashboard",
    "lint:dashboard": "npm run lint -w @firstbyte/dashboard",
    "typecheck:dashboard": "npm run typecheck -w @firstbyte/dashboard",
    "format:check:dashboard": "npm run format:check -w @firstbyte/dashboard",
    "lint:web": "npm run lint -w @firstbyte/web",
    "typecheck:web": "npm run typecheck -w @firstbyte/web",
    "format:check:web": "npm run format:check -w @firstbyte/web"
  }
}
